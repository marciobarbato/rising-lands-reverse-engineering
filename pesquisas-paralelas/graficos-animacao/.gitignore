# Local inputs; preserve manifests for SHA-256 recovery.
/fontes/**
!/fontes/manifesto.json
/snapshot/**
!/snapshot/manifesto.json
/dependencias/**
!/dependencias/manifesto.json

# Historical releases remain local and immutable; Git history retains public records.
/entregas/*/fontes/**
!/entregas/*/fontes/manifesto.json
/entregas/*/snapshot/**
!/entregas/*/snapshot/manifesto.json
/entregas/*/dependencias/**
!/entregas/*/dependencias/manifesto.json

# Transient and operational data for this domain.
**/__pycache__/
*.pyc
/tmp/
/cache/
/build/
/previa.png
/INVENTARIO_PUBLICACAO.json
/publicacao-pathspec.txt
/ESTADO.md

# Immutable releases live in the workspace archive; recover tracked records from Git history.
/entregas
